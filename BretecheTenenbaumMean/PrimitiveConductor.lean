module

public import Mathlib.NumberTheory.NumberField.Ideal.KummerDedekind
public import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed
public import Mathlib.LinearAlgebra.FreeModule.Finite.Quotient

@[expose] public section

/-! # Finitely many conductor primes for an integral primitive element

The finite-index argument follows the proofs in Tau Ceti's
`NumberTheory/NumberField/Index/Basic` and `Index/Exponent` at revision
`ea7e54cf967c2ab502c7e69bf69501e5a3ae3130` (Apache 2.0). We state just the
consequence needed here, using Mathlib's existing types.
-/

namespace BretecheTenenbaumMean

open Polynomial NumberField
open scoped NumberField

/-- The order generated by an integral primitive element has full rank. -/
theorem integralPrimitive_finrank_adjoin {K : Type*} [Field K] [NumberField K]
    (θ : 𝓞 K) (hθ : Algebra.adjoin ℚ {(θ : K)} = ⊤) :
    Module.finrank ℤ (Algebra.adjoin ℤ {θ}) = Module.finrank ℤ (𝓞 K) := by
  have hprim : IntermediateField.adjoin ℚ {(θ : K)} = ⊤ :=
    (IntermediateField.adjoin_eq_top_iff_of_isAlgebraic
      (fun x _ ↦ IsAlgebraic.of_finite ℚ x)).mpr hθ
  have hmin : minpoly ℚ (θ : K) = (minpoly ℤ θ).map (algebraMap ℤ ℚ) := by
    rw [minpoly.isIntegrallyClosed_eq_field_fractions' ℚ θ.isIntegral_coe,
      NumberField.RingOfIntegers.minpoly_coe]
  calc
    _ = (minpoly ℤ θ).natDegree := (Algebra.adjoin.powerBasis' θ.isIntegral).finrank
    _ = (minpoly ℚ (θ : K)).natDegree := by
      rw [hmin, (minpoly.monic θ.isIntegral).natDegree_map]
    _ = Module.finrank ℚ K :=
      (Field.primitive_element_iff_minpoly_natDegree_eq ℚ (θ : K)).mp hprim
    _ = Module.finrank ℤ (𝓞 K) := (NumberField.RingOfIntegers.rank K).symm

/-- The conductor exponent cannot vanish for an integral primitive element. -/
theorem integralPrimitive_exponent_pos {K : Type*} [Field K] [NumberField K]
    (θ : 𝓞 K) (hθ : Algebra.adjoin ℚ {(θ : K)} = ⊤) :
    0 < RingOfIntegers.exponent θ := by
  let A := (Algebra.adjoin ℤ {θ}).toSubmodule
  let : Finite (𝓞 K ⧸ A) :=
    Submodule.finiteQuotientOfFreeOfRankEq A (integralPrimitive_finrank_adjoin θ hθ)
  have hcard : 0 < Nat.card (𝓞 K ⧸ A) := Nat.card_pos
  have hmem : (Nat.card (𝓞 K ⧸ A) : 𝓞 K) ∈ conductor ℤ θ := by
    rw [mem_conductor_iff]
    intro b
    have h : Nat.card (𝓞 K ⧸ A) • A.mkQ b = 0 := card_nsmul_eq_zero'
    rw [← map_nsmul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h
    simpa [A, nsmul_eq_mul] using h
  have hdvd : RingOfIntegers.exponent θ ∣ Nat.card (𝓞 K ⧸ A) := by
    rwa [← Int.natCast_dvd_natCast, RingOfIntegers.exponent,
      ← Int.cast_mem_ideal_iff, Int.cast_natCast]
  exact Nat.pos_of_dvd_of_pos hdvd hcard

/-- Only finitely many rational primes are excluded from Kummer–Dedekind
for an integral primitive element. -/
theorem integralPrimitive_finite_badPrimes {K : Type*} [Field K] [NumberField K]
    (θ : 𝓞 K) (hθ : Algebra.adjoin ℚ {(θ : K)} = ⊤) :
    Set.Finite {p : ℕ | p.Prime ∧ p ∣ RingOfIntegers.exponent θ} := by
  exact (Set.finite_Iic (RingOfIntegers.exponent θ)).subset
    (fun _ hp ↦ Nat.le_of_dvd (integralPrimitive_exponent_pos θ hθ) hp.2)

end BretecheTenenbaumMean
