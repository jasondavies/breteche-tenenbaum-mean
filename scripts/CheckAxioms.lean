import all TauCeti.RingTheory.NormTrace.Pi
import all TauCeti.RingTheory.NormTrace.Prod
import all TauCeti.RingTheory.Valuation.AbsoluteValue
import all TauCeti.RingTheory.Valuation.Approximation
import all TauCeti.Topology.Algebra.InfiniteSum.Real
import all TauCeti.Topology.Frontier
import all TauCeti.Topology.MetricSpace.DiscreteAddSubgroup
import all TauCeti.Topology.MetricSpace.LipschitzParametrizable

meta import Lean

/-! Run after `lake build`. All project declarations, including private and generated
ones, are checked by defining module rather than by declaration namespace.
An omitted local source file is an error, so adding an unimported module cannot hide a proof hole.
The imported Nair–Tenenbaum and Tau Ceti dependency modules are also audited; their
source inventory and hashes are checked by `check-palomar.py --check-dependencies`.
-/

open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let scriptDir := (System.FilePath.mk (← getFileName)).parent.getD "."
  let root ← IO.FS.realPath (scriptDir / "..")
  for (sourceRoot, modPrefix) in #[(root / "BretecheTenenbaumMean", `BretecheTenenbaumMean),
      (root / "vendor" / "strong-pnt" / "IwaniecLinearSieveVendor", `IwaniecLinearSieveVendor)] do
    for path in ← sourceRoot.walkDir do
      if path.extension == some "lean" then
        let parts := (path.withExtension "").components.drop sourceRoot.components.length
        let name := parts.foldl Name.str modPrefix
        unless env.header.imports.any (fun i => i.module == name && i.importAll) do
          throwError "Source module {name} must be imported with `import all` in this audit"
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut checked : Nat := 0
  for name in env.header.moduleNames, data in env.header.moduleData do
    if (`BretecheTenenbaumMean).isPrefixOf name || (`IwaniecLinearSieveVendor).isPrefixOf name
        || (`NairTenenbaum).isPrefixOf name || (`TauCeti).isPrefixOf name then
      for decl in data.constNames do
        checked := checked + 1
        for ax in ← collectAxioms decl do
          unless allowed.contains ax do
            throwError "Unexpected axiom {ax} in {decl} (module {name})"
  if checked == 0 then
    throwError "No project declarations were audited"
  logInfo m!"Audited {checked} declarations; only propext, Classical.choice and Quot.sound found."
